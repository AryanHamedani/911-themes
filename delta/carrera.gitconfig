# Carrera v2.0.0 (Porsche 911 Heritage Cockpit) for git-delta
# Derived opaque diff/emphasis surfaces over #15171a:
#   #222a23 (diff add line), #3a4b3a (diff add word, 32% green mix),
#   #2d1e20 (diff delete line), #563537 (diff delete word, 32% red mix),
#   #31353f (commit-decoration-style border).
# Note: syntax-theme defaults to "ansi" for warning-free standalone usage.
# If you install ../bat/Carrera.tmTheme and run `bat cache --build`,
# you may set `syntax-theme = Carrera` in your [delta] section.

[delta "carrera"]
    dark = true
    syntax-theme = ansi
    plus-style = syntax "#222a23"
    plus-emph-style = syntax "#3a4b3a"
    plus-non-emph-style = syntax "#222a23"
    minus-style = syntax "#2d1e20"
    minus-emph-style = syntax "#563537"
    minus-non-emph-style = syntax "#2d1e20"
    zero-style = syntax
    line-numbers-plus-style = "#89b87f"
    line-numbers-minus-style = "#e07476"
    line-numbers-zero-style = "#838792"
    line-numbers-left-style = "#838792"
    line-numbers-right-style = "#838792"
    file-style = "#d6d2c7" bold
    file-decoration-style = "#e1656c" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#838792" box
    hunk-header-file-style = "#74a0d7"
    hunk-header-line-number-style = "#dcbb6a"
    commit-style = "#dcbb6a" bold
    commit-decoration-style = "#31353f" box
    blame-palette = "#15171a" "#1e2025" "#2b2e35"
    whitespace-error-style = "#eae6dc" "#e07476"
