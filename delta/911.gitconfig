# 911 (992.2) Precision Night Cockpit for git-delta
# Canonical surfaces over #141619:
#   Cockpit planes: #141619 (canvas), #1a1d23 (Vanadium elev), #1d2026 (lighter), #261b1f (Smoked Carmine)
#   Diff tints:     #202825 (add), #2d2023 (delete), #332024 (delete emph), #1f2731 (moved blue),
#                   #1d272b (moved cyan / merge ours), #282721 (moved yellow)
#   Chrome/borders: #2f3440 (divider), #434854 (box border), #5b5134 (grep match),
#                   #e55c5a (Guards Red lightbar), #bf3b3e + #f4f3ef (whitespace error badge).
# Requires ../bat/911.tmTheme installed via `bat cache --build` for syntax-theme = 911.

[delta "911"]
    dark = true
    syntax-theme = 911
    navigate = true
    hyperlinks = true
    line-numbers = true

    # Precision 2-tier diff highlights & inline word emphasis
    plus-style = syntax "#202825"
    plus-emph-style = "#98ce9f" bold ul "#202825"
    plus-non-emph-style = syntax "#202825"
    plus-empty-line-marker-style = normal "#202825"
    minus-style = syntax "#2d2023"
    minus-emph-style = "#f48583" bold ul "#332024"
    minus-non-emph-style = syntax "#2d2023"
    minus-empty-line-marker-style = normal "#2d2023"
    zero-style = syntax
    whitespace-error-style = "#f4f3ef" "#bf3b3e"
    inline-hint-style = "#858a96"

    # Moved-block mapping (for git diff --color-moved)
    map-styles = bold purple => syntax "#261b1f", bold blue => syntax "#1f2731", bold cyan => syntax "#1d272b", bold yellow => syntax "#282721"

    # Line numbers & tabular gutter
    line-numbers-left-format = "{nm:>4} "
    line-numbers-right-format = "{np:>4}│ "
    line-numbers-plus-style = "#7fb887"
    line-numbers-minus-style = "#e56c6a"
    line-numbers-zero-style = "#858a96"
    line-numbers-left-style = "#434854"
    line-numbers-right-style = "#434854"

    # Commit & file headers (Guards Red lightbar underline)
    commit-style = "#e0be66" bold
    commit-decoration-style = "#2f3440" box
    file-style = "#edede9" bold
    file-decoration-style = "#e55c5a" ul
    file-added-label = [+]
    file-copied-label = [C]
    file-modified-label = [M]
    file-removed-label = [-]
    file-renamed-label = [R]

    # Sculpted hunk headers
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#434854" box
    hunk-header-file-style = "#6fa2de" bold
    hunk-header-line-number-style = "#e0be66"

    # Git blame (4-step cockpit plane ladder)
    blame-palette = "#141619" "#1a1d23" "#1d2026" "#261b1f"
    blame-code-style = syntax
    blame-separator-style = "#2f3440"

    # Grep / ripgrep output (`rg --json | delta`)
    grep-file-style = "#6fa2de" bold
    grep-line-number-style = "#e0be66"
    grep-header-file-style = "#edede9" bold
    grep-header-decoration-style = "#434854" box
    grep-context-line-style = syntax
    grep-match-line-style = syntax "#1d2026"
    grep-match-word-style = "#edede9" bold "#5b5134"

    # Merge conflicts (zdiff3)
    merge-conflict-begin-symbol = ▼
    merge-conflict-end-symbol = ▲
    merge-conflict-ours-diff-header-style = "#84d8de" bold "#1d272b"
    merge-conflict-ours-diff-header-decoration-style = "#6ac4cb" box
    merge-conflict-theirs-diff-header-style = "#caa2e0" bold "#261b1f"
    merge-conflict-theirs-diff-header-decoration-style = "#b488cc" box
