<dict>
  <key>name</key>
  <string>911</string>
  <key>semanticClass</key>
  <string>theme.dark.911</string>
  <key>comment</key>
  <string>911 (992.2) Precision Night Cockpit for bat and delta. Base palette from colors.toml (#141619 Race-Tex Charcoal, #dadad6 Ice Grey, #e55c5a Guards/Carmine Red) with canonical derived cockpit planes (#0c0e11, #131519, #1a1d23, #261b1f), borders (#252932, #2f3440, #434854), filled badge (#bf3b3e/#f4f3ef), and opaque alpha-over-#141619 diff/diagnostic/search tints (#202825, #2d2023, #1f2731, #282721, #5b5134).</string>
  <key>settings</key>
  <array>
    <!-- Global Editor & Cockpit Chrome -->
    <dict>
      <key>settings</key>
