<dict>
  <key>name</key>
  <string>911</string>
  <key>semanticClass</key>
  <string>theme.dark.911</string>
  <key>comment</key>
  <string>911 (992.2) Precision Night Cockpit for bat. Base palette from colors.toml (#141619 Race-Tex Charcoal, #dadad6 Ice Grey, #e55c5a Guards/Carmine Red) with canonical derived cockpit planes (#0c0e11, #131519, #1a1d23, #261b1f), borders (#252932, #2f3440, #434854), filled badge (#bf3b3e/#f4f3ef), and opaque alpha-over-#141619 diff/search tints (#202825, #2d2023, #1f2731, #5b5134).</string>
  <key>settings</key>
  <array>
    <!-- Global Editor & Cockpit Chrome -->
    <dict>
      <key>settings</key>
      <dict>
        <key>background</key>
        <string>#141619</string>
        <key>foreground</key>
        <string>#dadad6</string>
        <key>caret</key>
        <string>#e55c5a</string>
        <key>lineHighlight</key>
        <string>#1d2026</string>
        <key>selection</key>
        <string>#292d36</string>
        <key>selectionForeground</key>
        <string>#edede9</string>
        <key>selectionBorder</key>
        <string>#2f3440</string>
        <key>inactiveSelection</key>
        <string>#1a1d23</string>
        <key>invisibles</key>
        <string>#434854</string>
        <key>gutter</key>
        <string>#141619</string>
        <key>gutterForeground</key>
        <string>#858a96</string>
        <key>findHighlight</key>
        <string>#5b5134</string>
        <key>findHighlightForeground</key>
        <string>#edede9</string>
        <key>guide</key>
        <string>#252932</string>
        <key>activeGuide</key>
        <string>#434854</string>
        <key>stackGuide</key>
        <string>#2f3440</string>
        <key>bracketsForeground</key>
        <string>#f48583</string>
        <key>bracketContentsForeground</key>
        <string>#dadad6</string>
        <key>tagsForeground</key>
        <string>#e56c6a</string>
        <key>shadow</key>
        <string>#0a0b0d</string>
      </dict>
    </dict>

