# Carrera v2.0.0 — Heritage Cockpit palette for zsh-syntax-highlighting
# Basalt Alcantara (#15171a), Chalk (#d6d2c7), Carmine Red (#e1656c)
# Requires a truecolor-capable terminal (24-bit #rrggbb).

typeset -gA ZSH_HIGHLIGHT_STYLES

# Main highlighter
ZSH_HIGHLIGHT_STYLES[default]='fg=#d6d2c7'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#e07476,bold'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg=#b886b8'
ZSH_HIGHLIGHT_STYLES[alias]='fg=#89b87f'
ZSH_HIGHLIGHT_STYLES[suffix-alias]='fg=#89b87f'
ZSH_HIGHLIGHT_STYLES[global-alias]='fg=#6fc7cb'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#74a0d7'
ZSH_HIGHLIGHT_STYLES[function]='fg=#74a0d7'
ZSH_HIGHLIGHT_STYLES[command]='fg=#89b87f'
ZSH_HIGHLIGHT_STYLES[precommand]='fg=#89b87f,underline'
ZSH_HIGHLIGHT_STYLES[commandseparator]='fg=#e1656c'
ZSH_HIGHLIGHT_STYLES[hashed-command]='fg=#89b87f'
ZSH_HIGHLIGHT_STYLES[autodirectory]='fg=#89b87f,underline'
ZSH_HIGHLIGHT_STYLES[path]='fg=#d6d2c7,underline'
ZSH_HIGHLIGHT_STYLES[path_pathseparator]='fg=#9599a2'
ZSH_HIGHLIGHT_STYLES[path_prefix]='fg=#d6d2c7,underline'
ZSH_HIGHLIGHT_STYLES[path_prefix_pathseparator]='fg=#9599a2'
ZSH_HIGHLIGHT_STYLES[globbing]='fg=#8eb9f0'
ZSH_HIGHLIGHT_STYLES[history-expansion]='fg=#d09fd1'
ZSH_HIGHLIGHT_STYLES[command-substitution]='fg=#d6d2c7'
ZSH_HIGHLIGHT_STYLES[command-substitution-unquoted]='fg=#d6d2c7'
ZSH_HIGHLIGHT_STYLES[command-substitution-quoted]='fg=#dcbb6a'
ZSH_HIGHLIGHT_STYLES[command-substitution-delimiter]='fg=#e1656c'
ZSH_HIGHLIGHT_STYLES[command-substitution-delimiter-unquoted]='fg=#e1656c'
ZSH_HIGHLIGHT_STYLES[command-substitution-delimiter-quoted]='fg=#b886b8'
ZSH_HIGHLIGHT_STYLES[process-substitution]='fg=#d6d2c7'
ZSH_HIGHLIGHT_STYLES[process-substitution-delimiter]='fg=#b886b8'
ZSH_HIGHLIGHT_STYLES[arithmetic-expansion]='fg=#e8965a'
ZSH_HIGHLIGHT_STYLES[single-hyphen-option]='fg=#b3afa6'
ZSH_HIGHLIGHT_STYLES[double-hyphen-option]='fg=#b3afa6'
ZSH_HIGHLIGHT_STYLES[back-quoted-argument]='fg=#d6d2c7'
ZSH_HIGHLIGHT_STYLES[back-quoted-argument-unclosed]='fg=#e07476,bold'
ZSH_HIGHLIGHT_STYLES[back-quoted-argument-delimiter]='fg=#e1656c'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#dcbb6a'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument-unclosed]='fg=#e07476,bold'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#dcbb6a'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument-unclosed]='fg=#e07476,bold'
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]='fg=#dcbb6a'
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument-unclosed]='fg=#e07476,bold'
ZSH_HIGHLIGHT_STYLES[rc-quote]='fg=#6fc7cb'
ZSH_HIGHLIGHT_STYLES[dollar-double-quoted-argument]='fg=#6fc7cb'
ZSH_HIGHLIGHT_STYLES[back-double-quoted-argument]='fg=#6fc7cb'
ZSH_HIGHLIGHT_STYLES[back-dollar-quoted-argument]='fg=#6fc7cb'
ZSH_HIGHLIGHT_STYLES[assign]='fg=#d6d2c7'
ZSH_HIGHLIGHT_STYLES[redirection]='fg=#e8965a'
ZSH_HIGHLIGHT_STYLES[comment]='fg=#838792'
ZSH_HIGHLIGHT_STYLES[named-fd]='fg=#ae7e62'
ZSH_HIGHLIGHT_STYLES[numeric-fd]='fg=#ae7e62'
ZSH_HIGHLIGHT_STYLES[arg0]='fg=#89b87f'

# Brackets highlighter
ZSH_HIGHLIGHT_STYLES[bracket-error]='fg=#e07476,bold'
ZSH_HIGHLIGHT_STYLES[bracket-level-1]='fg=#74a0d7,bold'
ZSH_HIGHLIGHT_STYLES[bracket-level-2]='fg=#dcbb6a,bold'
ZSH_HIGHLIGHT_STYLES[bracket-level-3]='fg=#89b87f,bold'
ZSH_HIGHLIGHT_STYLES[bracket-level-4]='fg=#b886b8,bold'
ZSH_HIGHLIGHT_STYLES[bracket-level-5]='fg=#6fc7cb,bold'
ZSH_HIGHLIGHT_STYLES[cursor-matchingbracket]='fg=#eae6dc,bg=#2b2e35,bold'

# Cursor, root & line highlighters
ZSH_HIGHLIGHT_STYLES[cursor]='bg=#2b2e35'
ZSH_HIGHLIGHT_STYLES[root]='fg=#15171a,bg=#e1656c,bold'
ZSH_HIGHLIGHT_STYLES[line]='none'
