# Carrera v2.0.0 (Porsche 911 Heritage Cockpit) for pgcli
# Merge [colors] into ~/.config/pgcli/config (optionally with [main] syntax_style = native).

[colors]
completion-menu.completion.current = 'bg:#2b2e35 #eae6dc bold'
completion-menu.completion = 'bg:#1e2025 #d6d2c7'
completion-menu.meta.completion.current = 'bg:#2b2e35 #e1656c'
completion-menu.meta.completion = 'bg:#101215 #9599a2'
completion-menu.multi-column-meta = 'bg:#1e2025 #b3afa6'
scrollbar.arrow = 'bg:#101215 #838792'
scrollbar = 'bg:#2b2e35'
selected = 'bg:#2b2e35 #eae6dc'
search = 'bg:#2b2e35 #dcbb6a'
search.current = 'bg:#e1656c #101215 bold'
bottom-toolbar = 'bg:#101215 #9599a2'
bottom-toolbar.off = 'bg:#101215 #838792'
bottom-toolbar.on = 'bg:#101215 #89b87f bold'
search-toolbar = 'bg:#101215 #eae6dc bold'
search-toolbar.text = '#d6d2c7 nobold'
system-toolbar = 'bg:#101215 #dcbb6a bold'
arg-toolbar = 'bg:#101215 #74a0d7 bold'
arg-toolbar.text = '#d6d2c7 nobold'
bottom-toolbar.transaction.valid = 'bg:#101215 #89b87f bold'
bottom-toolbar.transaction.failed = 'bg:#101215 #e07476 bold'
literal.string = '#89b87f'
literal.number = '#e8965a'
keyword = '#e07476 bold'
output.header = '#eae6dc bold'
output.odd-row = '#d6d2c7'
output.even-row = '#b3afa6'
output.null = '#838792 italic'
prompt = '#e1656c bold'
continuation = '#838792'
