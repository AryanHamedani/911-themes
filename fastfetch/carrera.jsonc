// Carrera v2.0.0 (Porsche 911 Heritage Cockpit) for Fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "color": {
      "1": "#e1656c",
      "2": "#eae6dc",
      "3": "#d6d2c7",
      "4": "#74a0d7",
      "5": "#6fc7cb",
      "6": "#89b87f",
      "7": "#dcbb6a",
      "8": "#b886b8",
      "9": "#838792"
    }
  },
  "display": {
    "color": {
      "keys": "#e1656c",
      "title": "#eae6dc",
      "output": "#d6d2c7",
      "separator": "#838792"
    },
    "percent": {
      "color": {
        "green": "#89b87f",
        "yellow": "#dcbb6a",
        "red": "#e07476"
      }
    },
    "bar": {
      "color": {
        "elapsed": "#e1656c",
        "total": "#2b2e35",
        "border": "#838792"
      }
    },
    "temp": {
      "color": {
        "green": "#89b87f",
        "yellow": "#dcbb6a",
        "red": "#e07476"
      }
    }
  }
}
