// 911 (992.2) Precision Night Cockpit for Fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    },
    "color": {
      "1": "#e55c5a",
      "2": "#edede9",
      "3": "#dadad6",
      "4": "#6fa2de",
      "5": "#6ac4cb",
      "6": "#7fb887",
      "7": "#e0be66",
      "8": "#b488cc",
      "9": "#858a96"
    }
  },
  "display": {
    "separator": " │ ",
    "color": {
      "keys": "#b4b7be",
      "title": "#e55c5a",
      "output": "#dadad6",
      "separator": "#858a96"
    },
    "duration": {
      "abbreviation": true,
      "spaceBeforeUnit": "never"
    },
    "size": {
      "ndigits": 1
    },
    "freq": {
      "ndigits": 1
    },
    "percent": {
      "type": 11,
      "ndigits": 0,
      "color": {
        "green": "#7fb887",
        "yellow": "#e0be66",
        "red": "#e56c6a"
      }
    },
    "bar": {
      "width": 10,
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "border": {
        "left": "[",
        "right": "]"
      },
      "color": {
        "total": "#292d36",
        "border": "#434854"
      }
    },
    "temp": {
      "unit": "C",
      "ndigits": 0,
      "color": {
        "green": "#7fb887",
        "yellow": "#e0be66",
        "red": "#e56c6a"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#e55c5a",
        "at": "#858a96",
        "host": "#edede9"
      }
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "#434854"
    },
    {
      "type": "os",
      "key": "OS      "
    },
    {
      "type": "kernel",
      "key": "Kernel  "
    },
    {
      "type": "uptime",
      "key": "Uptime  "
    },
    {
      "type": "packages",
      "key": "Packages"
    },
    {
      "type": "shell",
      "key": "Shell   "
    },
    {
      "type": "wm",
      "key": "WM      "
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    {
      "type": "cpu",
      "key": "CPU     ",
      "temp": true,
      "showPeCoreCount": true
    },
    {
      "type": "gpu",
      "key": "GPU     ",
      "temp": true
    },
    {
      "type": "memory",
      "key": "Memory  "
    },
    {
      "type": "disk",
      "key": "Disk    ",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "Battery "
    },
    {
      "type": "localip",
      "key": "Local IP",
      "compact": true,
      "showPrefixLen": false
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
